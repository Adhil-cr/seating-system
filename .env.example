# ==============================================================================
# ExamCell (BenchMap) Environment Configuration Template
# ==============================================================================

# Core Settings
EXAMCELL_MODE=cloud
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-50-character-secret-key

# Domain & Security
ALLOWED_HOSTS=benchmap.in,www.benchmap.in,.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://benchmap.in,https://www.benchmap.in,https://*.onrender.com
SECURE_SSL_REDIRECT=False

# PostgreSQL Database (Neon.tech or any persistent PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=600

# Python Runtime
PYTHON_VERSION=3.11.10

# Static & Media Storage
USE_WHITENOISE=True
# STATIC_ROOT=
# MEDIA_ROOT=

# Backblaze B2 Object Storage (Optional for offloading uploaded files)
B2_STORAGE_ENABLED=False
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=
# B2_ENDPOINT=
# B2_REGION=

# SMTP Email Configuration (Optional - falls back to console email backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@benchmap.in
